doctype html
- const rpDisplayName = typeof rpName === 'string' && rpName.trim() && rpName.trim().toLowerCase() !== 'undefined' ? rpName.trim() : 'Canadian Dental Care Plan'
html(lang="en")
	head
		meta(charset="utf-8")
		meta(name="viewport" content="width=device-width, initial-scale=1")
		title= title || (rpDisplayName + ' account')
		link(rel="stylesheet" href="https://cdn.design-system.canada.ca/@gcds-core/components@1.7.0/dist/gcds/gcds.css")
		script(type="module" src="https://cdn.design-system.canada.ca/@gcds-core/components@1.7.0/dist/gcds/gcds.esm.js")
		style.
			body { min-height: 100vh; margin: 0; display: flex; flex-direction: column; }
			#main-content { flex: 1; }
			.page-content, .error-content { width: 100%; max-width: 72rem; box-sizing: border-box; margin-inline: auto; padding: 3rem clamp(1rem, 4vw, 2.5rem) 3rem; overflow-wrap: anywhere; }
			.terms-content form { margin-top: 2rem; }
			gcds-header { --gcds-header-margin: 0; --gcds-header-brand-padding: 0.5rem 0; font-family: "Noto Sans", sans-serif; }
			.service-bar { display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; padding: 0.875rem max(1rem, calc((100% - 72rem) / 2)); background: #343b49; color: #fff; font-family: "Noto Sans", sans-serif; }
			.service-bar .service-title { margin-inline-start: 0; }
			.service-account-links { display: flex; gap: 1.625rem; }
			.service-account-links a, .service-account-links a:hover, .service-account-links a:visited { color: #fff; font: 400 1.25rem/1.2 "Noto Sans", sans-serif; text-decoration: none; }
			.dashboard-links { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: start; gap: 1rem; }
			.portal-content { width: 100%; max-width: 72rem; box-sizing: border-box; margin-inline: auto; padding: 4.125rem clamp(1rem, 4vw, 2.5rem) 4.25rem; }
			.portal-content gcds-heading {
				--gcds-heading-h1-desktop: 700 1.75rem/1.2 "Lato", sans-serif;
				--gcds-heading-h1-mobile: 700 1.75rem/1.2 "Lato", sans-serif;
				--gcds-heading-h1-border-width: 2rem;
				--gcds-heading-h1-border-height: 0.1875rem;
				--gcds-heading-h1-border-margin: 1rem 0 0;
				--gcds-heading-h2-desktop: 700 1.25rem/1.25 "Lato", sans-serif;
				--gcds-heading-h2-mobile: 700 1.25rem/1.25 "Lato", sans-serif;
			}
			.choice-panel { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; max-width: 48rem; box-sizing: border-box; margin: 2rem auto 0; padding: 0.25rem; border: 0.0625rem solid #d1d1d1; box-shadow: 0 0 0 0.3125rem #f4f4f4; }
			.choice { min-height: 6.25rem; padding: 1.75rem 2rem 2.75rem; }
			.choice + .choice { position: relative; }
			.choice + .choice::after { content: ""; position: absolute; top: 1.25rem; bottom: 0.25rem; left: 0; width: 0.0625rem; background: #777; }
			.choice + .choice::before { content: "or"; position: absolute; z-index: 1; top: 1.25rem; left: 0; transform: translate(-50%, -50%); width: 1.875rem; height: 1.875rem; border: 0.125rem solid #777; border-radius: 50%; background: #fff; display: grid; place-items: center; font-size: 0.875rem; font-weight: 700; }
			.choice gcds-button { --gcds-button-small-font-desktop: 400 0.875rem/1.2 "Lato", sans-serif; --gcds-button-small-font-mobile: 400 0.875rem/1.2 "Lato", sans-serif; --gcds-button-small-padding: 0.5rem 0.75rem; --gcds-button-width: 100%; display: block; }
			@media (max-width: 48rem) {
				.portal-content { padding-block: 2.25rem 3rem; }
			}
			@media (max-width: 36rem) {
				.service-bar { align-items: flex-start; flex-direction: column; gap: 0.5rem; padding: 0.75rem 1rem; }
				.service-account-links { gap: 1.125rem; }
				.portal-content { padding: 2rem 1rem 3rem; }
				.choice-panel { grid-template-columns: 1fr; }
				.choice { min-height: auto; }
				.choice + .choice::after { top: 0; right: 0; bottom: auto; width: auto; height: 0.0625rem; }
				.choice + .choice::before { top: 0; left: 50%; transform: translate(-50%, -50%); }
			}
	body
		gcds-header(lang-href="#" skip-to-href="#main-content")
		.service-bar
			gcds-text.service-title(size="small" text-role="light" margin-bottom="0")= rpDisplayName + ' account'
			if !portalShell
				nav.service-account-links(aria-label="Account")
					a(href="/manage-canadalogin") Manage CanadaLogin
					a(href="/logout") Sign out
		main#main-content
			gcds-container(layout="page")
				block content
		- const footerLinks = { [`About ${rpDisplayName}`]: '#', Help: '#', Privacy: '#', 'Terms and Conditions': '#' }
		gcds-footer(display="compact" sub-links=JSON.stringify(footerLinks))