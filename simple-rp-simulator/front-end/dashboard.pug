extends layout.pug

block content
	.page-content.dashboard-content
		.heading-block
			gcds-heading(tag="h1") My dashboard
		gcds-text.prompt(size="small") Choose from the following actions:
		nav.dashboard-links(aria-label="Dashboard actions")
			gcds-link(href="#" size="regular") View my letters
			gcds-link(href="#" size="regular") View applicant(s) information
			gcds-link(href="#" size="regular") Update access to other dental benefits
			gcds-link(href="#" size="regular") Update my contact information
			gcds-link(href="#" size="regular") Update my communication preferences
