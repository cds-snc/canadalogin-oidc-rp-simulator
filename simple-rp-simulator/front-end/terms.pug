extends layout.pug

block content
	.page-content.terms-content
		.heading-block
			gcds-heading(tag="h1") Terms of use and privacy notice statement
			gcds-heading(tag="h2" margin-top="300") Canadian Dental Care Plan terms
		ul
			li
				gcds-text(size="small" margin-bottom="0")
					a(href="#") Canadian Dental Care Plan
					|  uses CanadaLogin for identity and authentication management. CanadaLogin is managed by Employment and Social Development Canada and has its own privacy notice statement and terms of use.
					|  By accessing #{' '}
					|
					a(href="#") Canadian Dental Care Plan
					|  with your CanadaLogin you are subject to its terms.
		gcds-details(details-title="Full terms of use")
		gcds-heading(tag="h2" margin-top="300") Privacy Notice Statement
		ul
			li
				gcds-text(size="small" margin-bottom="0") Keep your credentials private.
			li
				gcds-text(size="small" margin-bottom="0") Keep your account information up to date.
			li
				gcds-text(size="small" margin-bottom="0") Use CanadaLogin only for lawful and authorized purposes.
		gcds-details(details-title="Full privacy notice statement")
		form(action="/terms" method="post")
			gcds-checkboxes.acknowledgement(name="acknowledgement" error-message=termsError options='[{"id":"terms-acknowledgement","value":"accepted","label":"I acknowledge that I have read the privacy notice, and I have read and agree to the Terms."}]')
			gcds-button(type="submit" size="small") Continue