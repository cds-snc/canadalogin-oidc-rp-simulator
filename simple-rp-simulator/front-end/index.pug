extends layout.pug

block content
	.portal-content
		gcds-heading(tag="h1" margin-bottom="400")= rpDisplayName + ' account'
		gcds-text.intro(size="small" margin-bottom="200") Your #{rpDisplayName} service portal account lets regulated entities submit legislative and supervisory reporting requirements.
		.choice-panel
			section.choice
				gcds-heading(tag="h2" margin-top="0" margin-bottom="200")= 'Sign in to ' + rpDisplayName
				gcds-button(type="link" size="small" href="/login") Sign in
			section.choice
				gcds-heading(tag="h2" margin-top="0" margin-bottom="200")= 'Register for ' + rpDisplayName
				gcds-button(type="link" button-role="secondary" size="small" href="/login") Register